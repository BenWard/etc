format = "$time${custom.user_host}$directory$git_branch${custom.git_marker} \\$ "
add_newline = false

[time]
disabled = false
format = "[\\[$time\\]]($style) "
time_format = "%H:%M"
style = "gray"

[custom.user_host]
command = """
if [[ -n "${SSH_CONNECTION:-}" || -n "${SSH_TTY:-}" ]]; then
  host="${HOSTNAME:-$(hostname)}"
  printf "~%s@%s" "${USER:-}" "${host%%.*}"
else
  printf "~%s" "${USER:-}"
fi
"""
format = "[$output]($style) "
shell = ["bash", "--noprofile", "--norc"]
style = "{{ .userHostColor }}"
when = "true"

[directory]
format = "[$path]($style)"
style = "yellow"
truncation_length = 100
truncate_to_repo = false

[git_branch]
format = "[#$branch]($style)"
style = "purple"

[custom.git_marker]
command = """
if [[ -n "$(git status --porcelain --ignore-submodules 2>/dev/null)" ]]; then
  printf "±"
else
  printf "="
fi
"""
format = " [$output]($style)"
require_repo = true
shell = ["bash", "--noprofile", "--norc"]
style = "purple"
when = "git rev-parse --is-inside-work-tree >/dev/null 2>&1"
