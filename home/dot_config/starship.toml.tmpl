format = "$time${custom.user_host}$directory$git_branch$git_state $git_status \\$ "
add_newline = false

[time]
disabled = false
format = "[\\[$time\\]]($style) "
time_format = "%H:%M"
style = "gray"

[custom.user_host]
command = """
if [[ -n "${SSH_CONNECTION:-}" || -n "${SSH_TTY:-}" ]]; then
  host="${HOSTNAME:-$(hostname)}"
  printf "~%s@%s" "${USER:-}" "${host%%.*}"
else
  printf "~%s" "${USER:-}"
fi
"""
format = "[$output]($style) "
shell = ["bash", "--noprofile", "--norc"]
style = "{{ .userHostColor }}"
when = "true"

[directory]
format = "[$path]($style)"
style = "yellow"
before_repo_root_style = "yellow"
repo_root_style = "yellow"
truncation_length = 3
truncation_symbol = "…/"
truncate_to_repo = true
repo_root_format = "[⟃$repo_root]($repo_root_style)[$path]($style)"

[git_branch]
format = "[#$branch]($style)"
only_attached = true
truncation_length = 30
style = "purple"

[git_state]
style = "bold purple"

[git_status]
style = "purple"
format = "([$all_status]($style))"
modified = "±"
conflicted = "!"
deleted = ""

[custom.git_marker]
disabled = true
command = """
if [[ -n "$(git status --porcelain --ignore-submodules 2>/dev/null)" ]]; then
  printf "±"
else
  printf "="
fi
"""
format = " [$output]($style)"
require_repo = true
shell = ["bash", "--noprofile", "--norc"]
style = "purple"
when = "git rev-parse --is-inside-work-tree >/dev/null 2>&1"
